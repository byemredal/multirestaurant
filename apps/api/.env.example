NODE_ENV=development

# API HTTP port. The whole platform standardizes on 4000 for local dev:
# README, docker-compose and every frontend's NEXT_PUBLIC_API_BASE_URL
# fallback assume http://localhost:4000/api/v1.
PORT=4000
API_PREFIX=api/v1

# Allowed browser origins. Include every frontend app (web 3000, admin 3051,
# tenant 3060, setup 3070) so local cross-app calls are not blocked.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3051,http://127.0.0.1:3051,http://localhost:3060,http://127.0.0.1:3060,http://localhost:3070,http://127.0.0.1:3070

# PostgreSQL connection. Host port 5433 maps to the dockerized Postgres
# (see infra/docker/docker-compose.override.yml — host 5433 -> container 5432).
# A non-docker local Postgres on the default 5432 should adjust this URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/lieferzonen

JWT_SECRET=phase3a-local-dev-secret

# Required to access setup endpoints while the platform is not yet READY.
BOOTSTRAP_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
PASSWORD_SALT_ROUNDS=10

AUTH_OAUTH_GOOGLE_CLIENT_ID=
AUTH_OAUTH_GOOGLE_CLIENT_SECRET=
AUTH_OAUTH_GOOGLE_REDIRECT_URI=
AUTH_OAUTH_FACEBOOK_CLIENT_ID=
AUTH_OAUTH_FACEBOOK_CLIENT_SECRET=
AUTH_OAUTH_FACEBOOK_REDIRECT_URI=

# Stripe payments (Switzerland / CHF). Optional at boot — the API starts
# without them, but payment actions return 503 until configured.
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# Signing secret of the Stripe webhook endpoint (whsec_...). For local dev with
# the Stripe CLI: `stripe listen --forward-to localhost:4000/api/v1/payments/webhook`.
STRIPE_WEBHOOK_SECRET=
# Customer web app base URL — used to build Stripe Checkout return URLs.
WEB_APP_BASE_URL=http://localhost:3000

# Tenant app base URL — used by the password-setup magic link sent on
# admin approval. Falls back to http://localhost:3060 when unset.
TENANT_APP_URL=http://localhost:3060

# LocationIQ key for the public /geo/suggest server-side proxy. The key
# never leaves the server. Without it /geo/suggest returns 503 and the
# tenant address autocomplete shows "Adres arama servisi şu an
# kullanılamıyor". Pick a free key at https://locationiq.com/.
LOCATIONIQ_API_KEY=

# Secret used to hash password-setup tokens before storage. Falls back to
# JWT_SECRET when unset — separate value recommended for prod so rotating
# JWT_SECRET does not invalidate outstanding setup links (or vice versa).
PASSWORD_SETUP_TOKEN_SECRET=
