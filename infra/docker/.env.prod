# Production environment for docker-compose.prod.yml
# Copy to `.env.prod` and fill in real values, then run:
#   docker compose --env-file infra/docker/.env.prod \
#     -f infra/docker/docker-compose.prod.yml up -d

# ── Required secrets ─────────────────────────────────────────────────────────
POSTGRES_PASSWORD=postgres
JWT_SECRET=change-me-at-least-16-characters
BOOTSTRAP_KEY=change-me-platform-bootstrap-key

# ── Required URLs / origins ──────────────────────────────────────────────────
# Comma-separated browser origins allowed by the API CORS allow-list.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3051,http://127.0.0.1:3051,http://localhost:3060,http://127.0.0.1:3060,http://localhost:3070,http://127.0.0.1:3070
# Public API base URL — baked into the frontends at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# ── Optional URLs ────────────────────────────────────────────────────────────
NEXT_PUBLIC_ADMIN_URL=http://localhost:3051
NEXT_PUBLIC_SETUP_URL=http://localhost:3070/setup
WEB_APP_BASE_URL=http://localhost:3000