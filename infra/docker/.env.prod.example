# Production environment template for docker-compose.prod.yml.
# Copy this file to .env.prod locally or in deployment secret storage.
# The API rejects missing, local, or placeholder production values.

POSTGRES_PASSWORD=
JWT_SECRET=
STATE_TOKEN_SECRET=
PASSWORD_SETUP_TOKEN_SECRET=
ONBOARDING_OTP_SECRET=
BOOTSTRAP_KEY=

CORS_ORIGINS=https://web.example.com,https://admin.example.com,https://tenant.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_ADMIN_URL=https://admin.example.com
NEXT_PUBLIC_SETUP_URL=https://setup.example.com/setup
WEB_APP_BASE_URL=https://web.example.com
TENANT_APP_URL=https://tenant.example.com

EMAIL_TRANSPORT=smtp
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
